local function terbangKePortalJikaGoldPenuh()
	local pg = localPlayer and localPlayer:FindFirstChildOfClass("PlayerGui")
	if not pg then return false end

	local penuh = false
	for _, v in ipairs(pg:GetDescendants()) do
		if v:IsA("TextLabel") or v:IsA("TextButton") then
			local t = string.lower(v.Text or "")
			local a, b = string.match(t, "(%d+)%s*/%s*(%d+)")
			if (a and b and tonumber(b) > 0 and tonumber(a) >= tonumber(b))
				or ((string.find(t, "full", 1, true) or string.find(t, "penuh", 1, true)) and #t <= 18) then
				penuh = true
				break
			end
		end
	end
	if not penuh then return false end

	local _, hrp = getCharParts()
	if not hrp then return false end

	local bestPos = nil
	local bestPrompt = nil
	local bestDist = math.huge

	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("ProximityPrompt") and obj.Enabled then
			local act = string.lower(obj.ActionText or "")
			local objTxt = string.lower(obj.ObjectText or "")
			local fullLow = string.lower(obj:GetFullName())
			if string.find(act, "teleport", 1, true) or string.find(objTxt, "pemburu emas", 1, true) or string.find(fullLow, "portal", 1, true) then
				local pPos = getTargetPosition(obj)
				if not pPos then
					local parent = obj.Parent
					if parent and parent:IsA("BasePart") then
						pPos = parent.Position
					elseif parent and parent:IsA("Attachment") then
						pPos = parent.WorldPosition
					else
						local m = obj:FindFirstAncestorOfClass("Model")
						if m then pPos = m:GetPivot().Position end
					end
				end
				if pPos then
					local d = (pPos - hrp.Position).Magnitude
					if d < bestDist then
						bestDist = d
						bestPos = pPos
						bestPrompt = obj
					end
				end
			end
		end
	end

	if bestPos then
		flyToPosition("PortalPemburuEmas", bestPos + Vector3.new(0, 2, 0))
		if bestPrompt then
			triggerPrompt(bestPrompt)
		end
		return true
	end

	return false
end
local function findGoldLocationPos(originPos)
	local bestPos = nil
	local bestDist = math.huge

	for _, obj in ipairs(workspace:GetDescendants()) do
		if isBlockedObject(obj) then
			continue
		end

		local fullLower = string.lower(obj:GetFullName())
		if string.find(fullLower, "location beam", 1, true) or string.find(fullLower, "sparkletube", 1, true) then
			if obj:IsA("Beam") or obj:IsA("Attachment") or obj:IsA("BasePart") then
				local pos = getTargetPosition(obj)
				if pos then
					local d = (pos - originPos).Magnitude
					if d < bestDist then
						bestDist = d
						bestPos = pos
					end
				end
			end
		end
	end

	return bestPos
end

-- Loop utama misi
task.spawn(function()
	while true do
		
    if kePortalMapUtamaJikaFull() then
		    task.wait(2)
		    continue
    end		
		if not missionEnabled then
			task.wait(0.15)
			continue
		end

		local _, hrp = getCharParts()
		if not hrp then
			task.wait(0.25)
			continue
		end

		if not anchorStartPos then
			anchorStartPos = hrp.Position
		end

		local goldPos = findGoldLocationPos(hrp.Position)

		if not goldPos then
			local stand = findScanningStand()
			local standPos = getTargetPosition(stand)
			if stand and standPos then
				flyToPosition("ScanningStand", standPos + Vector3.new(0, 2.5, 0))
				if missionEnabled then
					local scanPrompt = findPromptNearPos(standPos, 30)
					if scanPrompt then
						triggerPrompt(scanPrompt)
					end
				end
			else
				print("[GoldMission] ScanningStand belum ketemu")
			end

			local waitStart = os.clock()
			while missionEnabled and (os.clock() - waitStart) < 2.2 do
				local _, curHrp = getCharParts()
				goldPos = findGoldLocationPos(curHrp and curHrp.Position or hrp.Position)
				if goldPos then
					break
				end
				task.wait(0.12)
			end
		end

		if not missionEnabled then
			continue
		end
		if autoReturnEnabled and terbangKePortalJikaGoldPenuh() then task.wait(1.5) continue end

		if goldPos then
			flyToPosition("LocationBeam", goldPos + Vector3.new(0, 2.5, 0))
			if missionEnabled then
				local digPrompt = findPromptNearPos(goldPos, 30)
				if digPrompt then
					triggerPrompt(digPrompt)
				end
			end
		end

		task.wait(0.25)
	end
end)

