local saveAllSettings

local function applyCustomFlySpeedFromText(raw)
	local cleaned = tostring(raw or ""):gsub("[^%d%.]", "")
	local num = tonumber(cleaned)
	if num and num >= 40 and num <= 5000 then
		flySpeed = num
	end
	flySpeedInput.Text = tostring(flySpeed)
	if saveAllSettings then
		saveAllSettings()
	end
end

flySpeedInput.FocusLost:Connect(function()
	applyCustomFlySpeedFromText(flySpeedInput.Text)
end)

local function refreshReturnVisual()
	returnToggleBtn.Text = autoReturnEnabled and "AUTO RETURN : ON" or "AUTO RETURN : OFF"
	returnToggleBtn.BackgroundColor3 = autoReturnEnabled and Color3.fromRGB(145, 95, 20) or Color3.fromRGB(32, 36, 48)
	returnToggleBtn.TextColor3 = autoReturnEnabled and Color3.fromRGB(255, 230, 140) or Color3.fromRGB(205, 215, 230)
	if saveAllSettings then
		saveAllSettings()
	end
end

returnToggleBtn.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		autoReturnEnabled = not autoReturnEnabled
		if not autoReturnEnabled then
			returningActive = false
		end
		refreshReturnVisual()
	end
end)

local function refreshBtn()
	toggleBtn.Text = missionEnabled and "AUTO GOLD : ON" or "AUTO GOLD : OFF"
	toggleBtn.BackgroundColor3 = missionEnabled and Color3.fromRGB(22, 110, 65) or Color3.fromRGB(28, 36, 52)
	toggleBtn.TextColor3 = missionEnabled and Color3.fromRGB(145, 255, 190) or Color3.fromRGB(215, 225, 240)
	if saveAllSettings then
		saveAllSettings()
	end
end

toggleBtn.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		missionEnabled = not missionEnabled
		if missionEnabled then
			placedGoldMarkers = {}
			local _, hrp = getCharParts()
			anchorStartPos = hrp and hrp.Position or nil
		else
			anchorStartPos = nil
			local _, hrp, hum = getCharParts()
			if hrp then
				hrp.AssemblyLinearVelocity = Vector3.zero
			end
			if hum then
				hum.PlatformStand = false
			end
		end
		refreshBtn()
	end
end)

closeBtn.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		missionEnabled = false
		autoReturnEnabled = false
		returningActive = false
		smeltEnabled = false
		autoMissionEnabled = false
		autoExecEnabled = false
		sharedTurnOwner = nil
		placedGoldMarkers = {}
		anchorStartPos = nil
		if saveAllSettings then
			saveAllSettings()
		end
		screenGui:Destroy()
	end
end)

-- AUTO MISI (107, -16, -88) - delay 25 detik sebelum teleport ke misi
local refreshMissionVisual
local runAutoMissionCycle

task.spawn(function()
	local lpMission = Players.LocalPlayer

	local function waitMissionDelay(sec, token)
		local remaining = sec
		while remaining > 0 and autoMissionEnabled and token == missionRunToken do
			local step = math.min(remaining, 0.25)
			task.wait(step)
			remaining -= step
		end
		return autoMissionEnabled and token == missionRunToken
	end

	local function pressMissionKeyE(holdSec)
		pcall(function()
			VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
		end)
		task.wait(holdSec or 0.15)
		pcall(function()
			VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
		end)
	end

	local function triggerMissionPrompt(prompt)
		if not prompt or not prompt.Parent then
			pressMissionKeyE(0.18)
			return false
		end
		pcall(function()
			prompt.Enabled = true
		end)
		local holdTime = tonumber(prompt.HoldDuration) or 0
		local durasiTekan = (holdTime > 0) and (holdTime + 0.15) or 0.18
		pcall(function()
			prompt:InputHoldBegin()
		end)
		pressMissionKeyE(durasiTekan)
		pcall(function()
			prompt:InputHoldEnd()
		end)
		if typeof(fireproximityprompt) == "function" then
			pcall(fireproximityprompt, prompt)
		end
		pcall(function()
			ProximityPromptService:PromptTriggered(prompt, lpMission)
		end)
		return true
	end

	refreshMissionVisual = function()
		if autoMissionEnabled then
			missionTeleToggleBtn.BackgroundColor3 = Color3.fromRGB(24, 115, 70)
			missionTeleToggleBtn.Text = "AUTO MISI: ON"
			missionTeleToggleBtn.TextColor3 = Color3.fromRGB(220, 255, 235)
		else
			missionTeleToggleBtn.BackgroundColor3 = Color3.fromRGB(120, 32, 38)
			missionTeleToggleBtn.Text = "AUTO MISI: OFF"
			missionTeleToggleBtn.TextColor3 = Color3.fromRGB(255, 210, 215)
		end
		if saveAllSettings then
			saveAllSettings()
		end
	end

	runAutoMissionCycle = function(token)
		while autoMissionEnabled and token == missionRunToken do
			if not canTakeTurn("mission") then
				task.wait(0.35)
				continue
			end

			local prompt = findPromptNearCoord(MISSION_COORD, 22)
			if not prompt then
				releaseTurn("mission")
				task.wait(3)
				continue
			end

			if not waitMissionDelay(missionTeleportDelay, token) then
				break
			end

			if not autoMissionEnabled or token ~= missionRunToken then
				break
			end

			prompt = findPromptNearCoord(MISSION_COORD, 22)
			if not prompt then
				releaseTurn("mission")
				task.wait(3)
				continue
			end

			local char = lpMission and lpMission.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if hrp then
				hrp.AssemblyLinearVelocity = Vector3.zero
				hrp.CFrame = CFrame.new(MISSION_COORD + Vector3.new(0, 2, 0))
				task.wait(0.35)
				if not autoMissionEnabled or token ~= missionRunToken then
					break
				end
				triggerMissionPrompt(prompt)
			end

			releaseTurn("mission")
			task.wait(1.5)
		end
		if sharedTurnOwner == "mission" then
			sharedTurnOwner = smeltEnabled and "smelt" or nil
		end
	end

	missionTeleToggleBtn.MouseButton1Click:Connect(function()
		autoMissionEnabled = not autoMissionEnabled
		missionRunToken += 1
		if not (autoMissionEnabled and smeltEnabled) then
			sharedTurnOwner = nil
		elseif not sharedTurnOwner then
			sharedTurnOwner = "mission"
		end
		refreshMissionVisual()
		if autoMissionEnabled then
			local currentToken = missionRunToken
			task.spawn(function()
				runAutoMissionCycle(currentToken)
			end)
		end
	end)
end)

-- AUTO PELEBURAN (-15, -16, -120) - cek target dulu & giliran aman
local function runSmeltCycle(tok)
	while smeltEnabled and tok == smeltToken do
		if not canTakeTurn("smelt") then
			task.wait(0.35)
			continue
		end

		local prompt = findPromptNearCoord(SMELT_COORD, 22)
		if not prompt then
			releaseTurn("smelt")
			task.wait(3)
			continue
		end

		local _, hrp = getCharParts()
		if hrp then
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.CFrame = CFrame.new(SMELT_COORD + Vector3.new(0, 2.5, 0))
			task.wait(0.3)
			if not smeltEnabled or tok ~= smeltToken then
				break
			end
			triggerPrompt(prompt)
		end

		releaseTurn("smelt")
		task.wait(1.5)
	end
	if sharedTurnOwner == "smelt" then
		sharedTurnOwner = autoMissionEnabled and "mission" or nil
	end
end

local function refreshSmeltVisual()
	if smeltEnabled then
		smeltToggleBtn.BackgroundColor3 = Color3.fromRGB(24, 115, 70)
		smeltToggleBtn.Text = "AUTO PELEBURAN: ON"
		smeltToggleBtn.TextColor3 = Color3.fromRGB(220, 255, 235)
	else
		smeltToggleBtn.BackgroundColor3 = Color3.fromRGB(120, 32, 38)
		smeltToggleBtn.Text = "AUTO PELEBURAN: OFF"
		smeltToggleBtn.TextColor3 = Color3.fromRGB(255, 210, 215)
	end
	if saveAllSettings then
		saveAllSettings()
	end
end

smeltToggleBtn.MouseButton1Click:Connect(function()
	smeltEnabled = not smeltEnabled
	smeltToken += 1
	if not (autoMissionEnabled and smeltEnabled) then
		sharedTurnOwner = nil
	elseif not sharedTurnOwner then
		sharedTurnOwner = "smelt"
	end
	refreshSmeltVisual()
	if smeltEnabled then
		local tok = smeltToken
		task.spawn(function()
			runSmeltCycle(tok)
		end)
	end
end)

