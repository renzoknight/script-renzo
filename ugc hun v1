task.spawn(function()
	if typeof(missionTeleToggleBtn) ~= "Instance" then
		return
	end

	local ProximityPromptService = game:GetService("ProximityPromptService")
	local VirtualInputManager = game:GetService("VirtualInputManager")
	local lpMission = game:GetService("Players").LocalPlayer

	local MISSION_COORD = Vector3.new(107, -16, -88)

	local function findNearestMissionPrompt(refPos)
		local bestPrompt = nil
		local bestDist = math.huge

		for _, desc in ipairs(workspace:GetDescendants()) do
			if desc:IsA("ProximityPrompt") then
				local parent = desc.Parent
				local pos = nil
				if parent and parent:IsA("BasePart") then
					pos = parent.Position
				elseif parent and parent:IsA("Attachment") then
					pos = parent.WorldPosition
				elseif parent and parent:IsA("Model") then
					pos = (parent.PrimaryPart and parent.PrimaryPart.Position) or parent:GetPivot().Position
				end

				if pos then
					local distKeTitik = (pos - MISSION_COORD).Magnitude
					local distKeRef = (pos - refPos).Magnitude
					if distKeTitik <= 18 or distKeRef <= 15 then
						local d = math.min(distKeTitik, distKeRef)
						if d < bestDist then
							bestDist = d
							bestPrompt = desc
						end
					end
				end
			end
		end

		return bestPrompt
	end

	local function pressMissionKeyE(holdSec)
		pcall(function()
			VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
		end)
		task.wait(holdSec or 0.15)
		pcall(function()
			VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
		end)
	end

	local function triggerMissionPrompt(prompt)
		if not prompt or not prompt.Parent then
			pressMissionKeyE(0.18)
			return false
		end

		pcall(function()
			prompt.Enabled = true
		end)

		local holdTime = tonumber(prompt.HoldDuration) or 0
		local durasiTekan = (holdTime > 0) and (holdTime + 0.15) or 0.18

