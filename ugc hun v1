	end)

	return true
end

local function apakahOrePenuh()
	local roots = {}
	local pg = localPlayer and localPlayer:FindFirstChildOfClass("PlayerGui")
	if pg then
		table.insert(roots, pg)
	end
	if typeof(gethui) == "function" then
		local ok, hui = pcall(gethui)
		if ok and hui then
			table.insert(roots, hui)
		end
	end

	for _, root in ipairs(roots) do
		for _, v in ipairs(root:GetDescendants()) do
			if v:IsA("TextLabel") or v:IsA("TextButton") then
				local txt = string.lower(tostring(v.Text or ""):gsub("<[^>]->", ""))
				if string.find(txt, "ore is full", 1, true)
					or string.find(txt, "gold hunters lobby", 1, true)
					or (string.find(txt, "full", 1, true) and string.find(txt, "ore", 1, true))
				then
					return true
				end
			end
		end
	end

	return false
end

local function shouldPauseGold()
	return returningActive or (autoReturnEnabled and apakahOrePenuh())
end

local function flyToPosition(label, goalPos)
	local char, hrp, hum = getCharParts()
	if not char or not hrp or not hum or not goalPos then
		return false
	end

	if shouldPauseGold() then
		hrp.AssemblyLinearVelocity = Vector3.zero
		return false
	end

	local oldPlatformStand = hum.PlatformStand
	hum.PlatformStand = true

	local startClock = os.clock()
	local reached = false

	while missionEnabled and not shouldPauseGold() and (os.clock() - startClock) < stepTimeout do
		char, hrp, hum = getCharParts()
		if not char or not hrp or not hum then
			break
		end

		local currentPos = hrp.Position
		local delta = goalPos - currentPos
		local dist = delta.Magnitude

		if dist <= arriveDistance then
			hrp.AssemblyLinearVelocity = Vector3.zero
			reached = true
			break
		end

		local dt = RunService.Heartbeat:Wait()
		if not missionEnabled or shouldPauseGold() then
			break
		end

		local safeDt = math.min(dt, 0.05)
		local dir = delta.Unit
		local activeFlySpeed = math.max(tonumber(flySpeed) or 420, 40)
		local speedNow = (dist < 22) and math.max(activeFlySpeed * 0.75, 160) or activeFlySpeed
		local stepDist = math.min(speedNow * safeDt, dist)
		local nextPos = currentPos + dir * stepDist

		local lookTarget = Vector3.new(goalPos.X, nextPos.Y, goalPos.Z)
		hrp.AssemblyLinearVelocity = dir * speedNow
		if (lookTarget - nextPos).Magnitude > 0.05 then
			hrp.CFrame = CFrame.lookAt(nextPos, lookTarget)
		else
			hrp.CFrame = CFrame.new(nextPos)
		end
	end

	char, hrp, hum = getCharParts()
	if hrp then
		hrp.AssemblyLinearVelocity = Vector3.zero
	end
	if hum then
		hum.PlatformStand = oldPlatformStand
	end

	return reached
end

local function findAllGoldLocations()
	local list = {}
	for _, obj in ipairs(workspace:GetDescendants()) do
		if isBlockedObject(obj) then
			continue
		end

		local fullLower = string.lower(obj:GetFullName())
		if string.find(fullLower, "location beam", 1, true) or string.find(fullLower, "sparkletube", 1, true) then
			if obj:IsA("Beam") or obj:IsA("Attachment") or obj:IsA("BasePart") then
				local pos = getTargetPosition(obj)
				if pos then
					table.insert(list, pos)
				end
			end
		end
	end
	return list
end

local function findNextUnplacedGoldPos(originPos)
	local allGold = findAllGoldLocations()
	pruneMissingGoldMarkers(allGold)

	local bestPos = nil
	local bestDist = math.huge

	for _, pos in ipairs(allGold) do
		if not isAlreadyPlaced(pos) then
			local d = (pos - originPos).Magnitude
			if d < bestDist then
				bestDist = d
				bestPos = pos
			end
		end
	end

	return bestPos, #allGold > 0
end

local function kePortalMapUtamaJikaFull()
	if not autoReturnEnabled then
		returningActive = false
		return false
	end

	if not apakahOrePenuh() then
		returningActive = false
		return false
	end

	returningActive = true

	local char, hrp, hum = getCharParts()
	if not char or not hrp then
		return true
	end

	local targetPos, targetPrompt = nil, nil
	local bestDist = math.huge

	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("ProximityPrompt") then
			local act = string.lower(obj.ActionText or "")
			local objTxt = string.lower(obj.ObjectText or "")
			local fullLow = string.lower(obj:GetFullName())

			local isScanPrompt = string.find(act, "scan", 1, true)
				or string.find(objTxt, "scan", 1, true)
				or string.find(fullLow, "scan_prompt", 1, true)

			local isPortalPrompt = not isScanPrompt and (
				string.find(fullLow, "portal", 1, true)
				or (string.find(act, "teleport", 1, true) and not string.find(fullLow, "scan", 1, true))
				or string.find(objTxt, "pemburu emas", 1, true)
				or string.find(objTxt, "gold hunters", 1, true)
			)

			if isPortalPrompt then
				local p = obj.Parent
				local pos = nil
				if p and p:IsA("BasePart") then
					pos = p.Position
				elseif p and p:IsA("Attachment") then
					pos = p.WorldPosition
				else
					local partAnc = obj:FindFirstAncestorWhichIsA("BasePart")
					if partAnc then
						pos = partAnc.Position
					end
				end

				if pos then
					local d = (pos - hrp.Position).Magnitude
					if d < bestDist then
						bestDist = d
						targetPos = pos
						targetPrompt = obj
					end
				end
			end
		end
	end

	if not targetPos then
		targetPos = Vector3.new(582.7000122070312, -0.9881315231323242, 1962.6180419921875)
	end

	print("[GoldMission] Menuju portal:", targetPos)
	for _ = 1, 5 do
		char, hrp, hum = getCharParts()
		if not hrp then
			break
		end
		if hum then
			hum.PlatformStand = false
		end
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 1.5, 0))

		if targetPrompt and targetPrompt.Parent then
			triggerPrompt(targetPrompt)
		end

		task.wait(0.25)
	end

	return true
end

local function findPromptNearPos(refPos, maxDist)
	if not refPos then
		return nil
	end
	local bestPrompt = nil
	local bestDist = maxDist or 30
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("ProximityPrompt") and obj.Enabled and not isBlockedObject(obj) then
			local pPos = getTargetPosition(obj)
			if pPos then
				local d = (pPos - refPos).Magnitude
				if d <= bestDist then
					bestDist = d
					bestPrompt = obj
				end
			end
		end
	end
	return bestPrompt
end

-- Cek keberadaan target di area/map agar tidak teleport terus jika di luar map
local function findPromptNearCoord(coord, maxDist)
	local bestPrompt = nil
	local bestDist = maxDist or 22
	for _, desc in ipairs(workspace:GetDescendants()) do
		if desc:IsA("ProximityPrompt") then
			local parent = desc.Parent
			local pos = nil
			if parent and parent:IsA("BasePart") then
				pos = parent.Position
			elseif parent and parent:IsA("Attachment") then
				pos = parent.WorldPosition
			elseif parent and parent:IsA("Model") then
				pos = (parent.PrimaryPart and parent.PrimaryPart.Position) or parent:GetPivot().Position
			end
			if pos then
				local d = (pos - coord).Magnitude
				if d <= bestDist then
					bestDist = d
					bestPrompt = desc
				end
			end
		end
	end
	return bestPrompt
end

local function canTakeTurn(roleName)
	if autoMissionEnabled and smeltEnabled then
		if not sharedTurnOwner then
			sharedTurnOwner = roleName
		end
		return sharedTurnOwner == roleName
	end
	return true
end

local function releaseTurn(roleName)
	if autoMissionEnabled and smeltEnabled and sharedTurnOwner == roleName then
		sharedTurnOwner = (roleName == "mission") and "smelt" or "mission"
	elseif not (autoMissionEnabled and smeltEnabled) then
		sharedTurnOwner = nil
	end
end

-- Loop utama AUTO GOLD: letak cepat ke titik kuning yang belum diletak (tidak nunggu selesai), lalu pindah ke kuning lain; jika semua sudah/habis baru ambil mesin lagi
task.spawn(function()
	while true do
		if kePortalMapUtamaJikaFull() then
			task.wait(1)
			continue
		end

		if not missionEnabled or shouldPauseGold() then
			task.wait(0.1)
			continue
		end

		local _, hrp = getCharParts()
		if not hrp then
			task.wait(0.2)
			continue
		end

		if not anchorStartPos then
			anchorStartPos = hrp.Position
		end

		local nextGoldPos, anyGoldExists = findNextUnplacedGoldPos(hrp.Position)
		if nextGoldPos then
			flyToPosition("Kuning Peleburan", nextGoldPos + Vector3.new(0, 2.5, 0))
			if missionEnabled and not shouldPauseGold() then
				local actionPrompt = findPromptNearPos(nextGoldPos, 30)
				if actionPrompt then
					triggerPromptFast(actionPrompt)
				end
				-- Langsung tandai sudah diletak tanpa menunggu animasi/proses selesai
				markGoldPlaced(nextGoldPos)
			end
			task.wait(0.15)
			continue
		end

		-- Jika semua kuning sudah diletak atau kuning-kuning sudah hilang, ambil mesin pelebur di tempat ambil mesin
		if not anyGoldExists and missionEnabled and not shouldPauseGold() then
			placedGoldMarkers = {}
			local takePrompt = findPromptNearCoord(SMELT_COORD, 25)
			if takePrompt then
				flyToPosition("Ambil Mesin Pelebur", SMELT_COORD + Vector3.new(0, 2.5, 0))
				if missionEnabled and not shouldPauseGold() then
					triggerPromptFast(takePrompt)
				end
				local waitStart = os.clock()
				while missionEnabled and not shouldPauseGold() and (os.clock() - waitStart) < 1.8 do
					if #findAllGoldLocations() > 0 then
						break
					end
					task.wait(0.1)
				end
			else
				task.wait(0.8)
			end
		else
			task.wait(0.15)
		end

		task.wait(0.1)
	end
end)

