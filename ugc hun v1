-- Pengaturan utama
local missionEnabled = false
local flySpeed = 230
local arriveDistance = 5.5
local stepTimeout = 18
local MAX_DIST_FROM_START = 2000

local anchorStartPos = nil

local BLOCKED_WORDS = {
	"portal", "infoboard", "lobby", "hub", "spawn", "return", "back", "menu", "exit", "shop"
}

local function getCharParts()
	local char = localPlayer.Character
	if not char then
		return nil, nil, nil
	end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then
		return nil, nil, nil
	end
	return char, hrp, hum
end

local function isBlockedObject(obj)
	if not obj then
		return true
	end
	local fullLower = string.lower(obj:GetFullName())
	for _, bad in ipairs(BLOCKED_WORDS) do
		if string.find(fullLower, bad, 1, true) then
			return true
		end
	end
	return false
end

local function isWithinMissionArea(pos)
	if not pos or typeof(pos) ~= "Vector3" then
		return false
	end
	if math.abs(pos.X) > 6000 or math.abs(pos.Z) > 6000 or pos.Y > 900 or pos.Y < -300 then
		return false
	end
	if anchorStartPos then
		local horizDist = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(anchorStartPos.X, 0, anchorStartPos.Z)).Magnitude
		if horizDist > MAX_DIST_FROM_START then
			return false
		end
	end
	return true
end

local function getTargetPosition(obj)
	if not obj or not obj.Parent or isBlockedObject(obj) then
		return nil
	end

	local pos = nil
	if obj:IsA("ProximityPrompt") then
		local parent = obj.Parent
		if parent and parent:IsA("BasePart") then
			pos = parent.Position
		elseif parent and parent:IsA("Attachment") then
			pos = parent.WorldPosition
		else
			local model = obj:FindFirstAncestorOfClass("Model")
			if model then
				pos = model:GetPivot().Position
			end
		end
	elseif obj:IsA("Beam") then
		local a0 = obj.Attachment0
		local a1 = obj.Attachment1
		if a0 and a1 then
			pos = (a0.WorldPosition.Y <= a1.WorldPosition.Y) and a0.WorldPosition or a1.WorldPosition
		elseif a0 then
			pos = a0.WorldPosition
		elseif a1 then
			pos = a1.WorldPosition
		end
	elseif obj:IsA("BasePart") then
		pos = obj.Position
	elseif obj:IsA("Attachment") then
		pos = obj.WorldPosition
	elseif obj:IsA("Model") then
		pos = obj:GetPivot().Position
	end

	if isWithinMissionArea(pos) then
		return pos
	end
	return nil
end

local function triggerPrompt(prompt)
	if not prompt or not prompt.Parent or not prompt.Enabled or isBlockedObject(prompt) then
		return false
	end

	pcall(function()
		prompt.MaxActivationDistance = math.max(prompt.MaxActivationDistance, 25)
	end)

	local fired = false
	if typeof(fireproximityprompt) == "function" then
		local ok = pcall(function()
			fireproximityprompt(prompt)
		end)
		if ok then
			fired = true
		end
	end

	if not fired then
		pcall(function()
			prompt:InputHoldBegin()
			task.wait(math.max(prompt.HoldDuration, 0.08))
			prompt:InputHoldEnd()
		end)
	end

	return true
end

local function flyToPosition(label, goalPos)
	local char, hrp, hum = getCharParts()
	if not char or not hrp or not hum or not goalPos then
		return false
	end

	print("[GoldMission] Terbang ke", label)

	local oldPlatformStand = hum.PlatformStand
	hum.PlatformStand = true

	local startClock = os.clock()
	local reached = false

	while missionEnabled and (os.clock() - startClock) < stepTimeout do
		char, hrp, hum = getCharParts()
		if not char or not hrp or not hum then
			break
		end

		local currentPos = hrp.Position
		local delta = goalPos - currentPos
		local dist = delta.Magnitude

		if dist <= arriveDistance then
			hrp.AssemblyLinearVelocity = Vector3.zero
			reached = true
			break
		end

		local dt = RunService.Heartbeat:Wait()
		local safeDt = math.min(dt, 0.05)
		local dir = delta.Unit
		local speedNow = (dist < 18) and math.max(flySpeed * 0.55, 85) or flySpeed
		local stepDist = math.min(speedNow * safeDt, dist)
		local nextPos = currentPos + dir * stepDist

		local lookTarget = Vector3.new(goalPos.X, nextPos.Y, goalPos.Z)
		hrp.AssemblyLinearVelocity = dir * speedNow
		if (lookTarget - nextPos).Magnitude > 0.05 then
			hrp.CFrame = CFrame.lookAt(nextPos, lookTarget)
		else
			hrp.CFrame = CFrame.new(nextPos)
		end
	end

	char, hrp, hum = getCharParts()
	if hrp then
		hrp.AssemblyLinearVelocity = Vector3.zero
	end
	if hum then
		hum.PlatformStand = oldPlatformStand
	end

	return reached
end

local function findScanningStand()
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj.Name == "ScanningStand" and not isBlockedObject(obj) then
			if getTargetPosition(obj) then
				return obj
			end
		end
	end
	return nil
end
local autoReturnAktif = true

local function apakahOrePenuh()
	local pg = lp and lp:FindFirstChildOfClass("PlayerGui")
	if not pg then return false end

	local toast = pg:FindFirstChild("Toast")
	local content = toast and toast:FindFirstChild("@CONTENT")
	local clue = content and content:FindFirstChild("@CLUE")

	if clue and (clue:IsA("TextLabel") or clue:IsA("TextButton")) and clue.Visible then
		local txt = string.lower(tostring(clue.Text or ""):gsub("<[^>]->", ""))
		if string.find(txt, "ore is full", 1, true) then
			return true
		end
	end

	return false
end

local function kePortalMapUtamaJikaFull()
	if not autoReturnAktif or not apakahOrePenuh() then
		return false
	end

	local char = lp and lp.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp then return false end

	local bestPos, bestPrompt = nil, nil
	local bestDist = math.huge

	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("ProximityPrompt") and obj.Enabled then
			local act = string.lower(obj.ActionText or "")
			local objTxt = string.lower(obj.ObjectText or "")
			local fullLow = string.lower(obj:GetFullName())

			if string.find(act, "teleport", 1, true)
				or string.find(objTxt, "pemburu emas", 1, true)
				or string.find(fullLow, "portal", 1, true)
			then
				local p = obj.Parent
				local pos = nil
				if p and p:IsA("BasePart") then
					pos = p.Position
				elseif p and p:IsA("Attachment") then
					pos = p.WorldPosition
				else
					local m = obj:FindFirstAncestorOfClass("Model")
					if m then pos = m:GetPivot().Position end
				end

				if pos then
					local dist = (pos - hrp.Position).Magnitude
					if dist < bestDist then
						bestDist = dist
						bestPos = pos
						bestPrompt = obj
					end
				end
			end
		end
	end

	if bestPos and bestPrompt then
		local goal = CFrame.new(bestPos + Vector3.new(0, 2, 0))
		local dur = math.clamp((hrp.Position - goal.Position).Magnitude / 95, 0.1, 15)
		if hum then hum.PlatformStand = true end
		local tw = game:GetService("TweenService"):Create(
			hrp,
			TweenInfo.new(dur, Enum.EasingStyle.Linear),
			{ CFrame = goal }
		)
		tw:Play()
		tw.Completed:Wait()
		if hum then hum.PlatformStand = false end

		task.wait(0.35)
		if typeof(fireproximityprompt) == "function" then
			pcall(fireproximityprompt, bestPrompt)
		else
			bestPrompt:InputHoldBegin()
			task.wait(math.max(bestPrompt.HoldDuration or 0, 0.1))
			bestPrompt:InputHoldEnd()
		end
		return true
	end

	return false
end

local function findPromptNearPos(refPos, maxDist)
	if not refPos then
		return nil
	end
	local bestPrompt = nil
	local bestDist = maxDist or 30
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("ProximityPrompt") and obj.Enabled and not isBlockedObject(obj) then
			local pPos = getTargetPosition(obj)
			if pPos then
				local d = (pPos - refPos).Magnitude
				if d <= bestDist then
					bestDist = d
					bestPrompt = obj
				end
			end
		end
	end
	return bestPrompt
end

