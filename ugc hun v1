local function makePosKey(pos)
	if not pos then return "" end
	return string.format("%d_%d_%d", math.floor(pos.X + 0.5), math.floor(pos.Y + 0.5), math.floor(pos.Z + 0.5))
end

local function isAlreadyPlaced(pos)
	if not pos then return false end
	local key = makePosKey(pos)
	if placedGoldMarkers[key] then
		return true
	end
	for _, recordedPos in pairs(placedGoldMarkers) do
		if typeof(recordedPos) == "Vector3" and (recordedPos - pos).Magnitude <= 4.5 then
			return true
		end
	end
	return false
end

local function markGoldPlaced(pos)
	if not pos then return end
	local key = makePosKey(pos)
	placedGoldMarkers[key] = pos
end

local function pruneMissingGoldMarkers(activePositions)
	for key, recordedPos in pairs(placedGoldMarkers) do
		if typeof(recordedPos) == "Vector3" then
			local stillExists = false
			for _, p in ipairs(activePositions) do
				if (p - recordedPos).Magnitude <= 5.0 then
					stillExists = true
					break
				end
			end
			if not stillExists then
				placedGoldMarkers[key] = nil
			end
		else
			placedGoldMarkers[key] = nil
		end
	end
end

local function getCharParts()
	local char = localPlayer.Character
	if not char then
		return nil, nil, nil
	end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then
		return nil, nil, nil
	end
	return char, hrp, hum
end

local function isBlockedObject(obj)
	if not obj then
		return true
	end
	local fullLower = string.lower(obj:GetFullName())
	for _, bad in ipairs(BLOCKED_WORDS) do
		if string.find(fullLower, bad, 1, true) then
			return true
		end
	end
	return false
end

local function isWithinMissionArea(pos)
	if not pos or typeof(pos) ~= "Vector3" then
		return false
	end
	if math.abs(pos.X) > 6000 or math.abs(pos.Z) > 6000 or pos.Y > 900 or pos.Y < -300 then
		return false
	end
	if anchorStartPos then
		local horizDist = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(anchorStartPos.X, 0, anchorStartPos.Z)).Magnitude
		if horizDist > MAX_DIST_FROM_START then
			return false
		end
	end
	return true
end

local function getInstanceWorldPos(inst)
	if not inst then
		return nil
	end
	if inst:IsA("BasePart") then
		return inst.Position
	elseif inst:IsA("Attachment") then
		return inst.WorldPosition
	elseif inst:IsA("Model") then
		return (inst.PrimaryPart and inst.PrimaryPart.Position) or inst:GetPivot().Position
	else
		local partAnc = inst:FindFirstAncestorWhichIsA("BasePart")
		if partAnc then
			return partAnc.Position
		end
		local modelAnc = inst:FindFirstAncestorOfClass("Model")
		if modelAnc then
			return modelAnc:GetPivot().Position
		end
	end
	return nil
end

local function getTargetPosition(obj)
	if not obj or not obj.Parent or isBlockedObject(obj) then
		return nil
	end

	local pos = nil
	if obj:IsA("ProximityPrompt") then
		pos = getInstanceWorldPos(obj.Parent) or getInstanceWorldPos(obj)
	elseif obj:IsA("Beam") then
		local a0 = obj.Attachment0
		local a1 = obj.Attachment1
		if a0 and a1 then
			pos = (a0.WorldPosition.Y <= a1.WorldPosition.Y) and a0.WorldPosition or a1.WorldPosition
		elseif a0 then
			pos = a0.WorldPosition
		elseif a1 then
			pos = a1.WorldPosition
		end
	else
		pos = getInstanceWorldPos(obj)
	end

	if isWithinMissionArea(pos) then
		return pos
	end
	return nil
end

-- Makin kecil eDelay = makin cepat E; makin besar eDelay = makin lambat E
local function pressKeyE(customDelay)
	local d = math.clamp(tonumber(customDelay) or tonumber(eDelay) or 0.03, 0.01, 5)
	pcall(function()
		VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
	end)
	task.wait(d)
	pcall(function()
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
	end)
end

local function triggerPromptFast(prompt)
	if prompt and prompt.Parent and not isBlockedObject(prompt) then
		pcall(function()
			prompt.Enabled = true
			prompt.RequiresLineOfSight = false
			prompt.MaxActivationDistance = math.max(prompt.MaxActivationDistance, 65)
		end)

		local fired = false
		if typeof(fireproximityprompt) == "function" then
			local ok = pcall(function()
				fireproximityprompt(prompt)
			end)
			if ok then
				fired = true
			end
		end

		if not fired then
			pcall(function()
				prompt:InputHoldBegin()
				prompt:InputHoldEnd()
			end)
		end

		pcall(function()
			ProximityPromptService:PromptTriggered(prompt, localPlayer)
		end)
	end

	pressKeyE(eDelay)
	return true
end

local function triggerPrompt(prompt)
	if not prompt or not prompt.Parent then
		pressKeyE(0.12)
		return false
	end

	pcall(function()
		prompt.Enabled = true
		prompt.RequiresLineOfSight = false
		prompt.MaxActivationDistance = math.max(prompt.MaxActivationDistance, 65)
	end)

	local fired = false
	if typeof(fireproximityprompt) == "function" then
		local ok = pcall(function()
			fireproximityprompt(prompt)
		end)
		if ok then
			fired = true
		end
	end

	if not fired then
		pcall(function()
			prompt:InputHoldBegin()
			task.wait(math.clamp(tonumber(prompt.HoldDuration) or 0.08, 0.05, 0.2))
			prompt:InputHoldEnd()
		end)
	end

	pcall(function()
		ProximityPromptService:PromptTriggered(prompt, localPlayer)
	end)

	pressKeyE(0.12)
	return true
end

local function findPromptNearPos(refPos, maxDist)
	if not refPos then
		return nil
	end
	local bestPrompt = nil
	local bestDist = maxDist or 35
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("ProximityPrompt") and obj.Enabled and not isBlockedObject(obj) then
			local pPos = getTargetPosition(obj)
			if pPos then
				local d = (pPos - refPos).Magnitude
				if d <= bestDist then
					bestDist = d
					bestPrompt = obj
				end
			end
		end
	end
	return bestPrompt
end

function findPromptNearCoord(coord, maxDist)
	local bestPrompt = nil
	local bestDist = maxDist or 22
	for _, desc in ipairs(workspace:GetDescendants()) do
		if desc:IsA("ProximityPrompt") and desc.Enabled and not isBlockedObject(desc) then
			local pos = getInstanceWorldPos(desc.Parent) or getInstanceWorldPos(desc)
			if pos then
				local d = (pos - coord).Magnitude
				if d <= bestDist then
					bestDist = d
					bestPrompt = desc
				end
			end
		end
	end
	return bestPrompt
end

-- Cari prompt / mesin "SCAN FOR GOLD" (bukan portal, bukan podium jubah, bukan ore)
local function findGoldMachineTakeTarget(originPos)
	local bestPos = nil
	local bestPrompt = nil
	local bestScore = math.huge

	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("ProximityPrompt") then
			local act = string.lower(tostring(obj.ActionText or ""))
			local objTxt = string.lower(tostring(obj.ObjectText or ""))
			local fullLow = string.lower(obj:GetFullName())

			local isPortal = string.find(fullLow, "portal", 1, true)
				or string.find(act, "portal", 1, true)
				or string.find(objTxt, "portal", 1, true)
				or string.find(objTxt, "lobby", 1, true)

			local isBlocked = isPortal
				or string.find(fullLow, "cape", 1, true)
				or string.find(fullLow, "halo", 1, true)
				or string.find(fullLow, "crown", 1, true)
				or string.find(fullLow, "ugc", 1, true)
				or string.find(fullLow, "podium", 1, true)
				or string.find(fullLow, "pedestal", 1, true)
				or string.find(fullLow, "ore", 1, true)

			local isMachinePrompt = not isBlocked and (
				string.find(act, "scan", 1, true)
				or string.find(objTxt, "scan", 1, true)
				or string.find(objTxt, "gold", 1, true)
				or string.find(fullLow, "scan", 1, true)
				or string.find(fullLow, "smelt", 1, true)
				or string.find(fullLow, "machine", 1, true)
			)

			if isMachinePrompt then
				local pos = getInstanceWorldPos(obj.Parent) or getInstanceWorldPos(obj)
				if pos then
					local d = originPos and (pos - originPos).Magnitude or 0
					if d < bestScore then
						bestScore = d
						bestPos = pos
						bestPrompt = obj
					end
				end
			end
		end
	end

	if not bestPos then
		for _, obj in ipairs(workspace:GetDescendants()) do
			local fullLow = string.lower(obj:GetFullName())
			local nameLow = string.lower(obj.Name)
			local isBlocked = string.find(fullLow, "portal", 1, true)
				or string.find(fullLow, "cape", 1, true)
				or string.find(fullLow, "halo", 1, true)
				or string.find(fullLow, "crown", 1, true)
				or string.find(fullLow, "ugc", 1, true)
				or string.find(fullLow, "podium", 1, true)
				or string.find(fullLow, "pedestal", 1, true)
				or string.find(fullLow, "ore", 1, true)

			if not isBlocked and (
				string.find(nameLow, "scanningstand", 1, true)
				or string.find(nameLow, "scan", 1, true)
				or string.find(nameLow, "smelt", 1, true)
			) then
				local pos = getInstanceWorldPos(obj)
				if pos then
					local d = originPos and (pos - originPos).Magnitude or 0
					if d < bestScore then
						bestScore = d
						bestPos = pos
						bestPrompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
					end
				end
			end
		end
	end

	if bestPos then
		lastMachinePos = bestPos
		return bestPos, bestPrompt
	end

	if lastMachinePos then
		return lastMachinePos, nil
	end

	return nil, nil
end

local function apakahOrePenuh()
	local roots = {}
	local pg = localPlayer and localPlayer:FindFirstChildOfClass("PlayerGui")
	if pg then
		table.insert(roots, pg)
	end
	if typeof(gethui) == "function" then
		local ok, hui = pcall(gethui)
		if ok and hui then
			table.insert(roots, hui)
		end
	end

	for _, root in ipairs(roots) do
		for _, v in ipairs(root:GetDescendants()) do
			if v:IsA("TextLabel") or v:IsA("TextButton") then
				local txt = string.lower(tostring(v.Text or ""):gsub("<[^>]->", ""))
				if string.find(txt, "ore is full", 1, true)
					or string.find(txt, "gold hunters lobby", 1, true)
					or (string.find(txt, "full", 1, true) and string.find(txt, "ore", 1, true))
				then
					return true
				end
			end
		end
	end

	return false
end

local function shouldPauseGold()
	return smeltBusy or returningActive or (autoReturnEnabled and apakahOrePenuh())
end

local function flyToPosition(label, goalPos)
	local char, hrp, hum = getCharParts()
	if not char or not hrp or not hum or not goalPos then
		return false
	end

	if shouldPauseGold() then
		hrp.AssemblyLinearVelocity = Vector3.zero
		return false
	end

	local oldPlatformStand = hum.PlatformStand
	hum.PlatformStand = true

	local startClock = os.clock()
	local reached = false

	while missionEnabled and not shouldPauseGold() and (os.clock() - startClock) < stepTimeout do
		char, hrp, hum = getCharParts()
		if not char or not hrp or not hum then
			break
		end

		local currentPos = hrp.Position
		local delta = goalPos - currentPos
		local dist = delta.Magnitude

		if dist <= arriveDistance then
			hrp.AssemblyLinearVelocity = Vector3.zero
			reached = true
			break
		end

		local dt = RunService.Heartbeat:Wait()
		if not missionEnabled or shouldPauseGold() then
			break
		end

		local safeDt = math.min(dt, 0.05)
		local dir = delta.Unit
		local activeFlySpeed = math.max(tonumber(flySpeed) or 420, 40)
		local speedNow = (dist < 24) and math.max(activeFlySpeed * 0.72, 150) or activeFlySpeed
		local stepDist = math.min(speedNow * safeDt, dist)
		local nextPos = currentPos + dir * stepDist

		local lookTarget = Vector3.new(goalPos.X, nextPos.Y, goalPos.Z)
		hrp.AssemblyLinearVelocity = dir * speedNow
		if (lookTarget - nextPos).Magnitude > 0.05 then
			hrp.CFrame = CFrame.lookAt(nextPos, lookTarget)
		else
			hrp.CFrame = CFrame.new(nextPos)
		end
	end

	char, hrp, hum = getCharParts()
	if hrp then
		hrp.AssemblyLinearVelocity = Vector3.zero
	end
	if hum then
		hum.PlatformStand = oldPlatformStand
	end

	return reached
end

local function findAllGoldLocations()
	local list = {}
	for _, obj in ipairs(workspace:GetDescendants()) do
		if isBlockedObject(obj) then
			continue
		end

		local fullLower = string.lower(obj:GetFullName())
		if string.find(fullLower, "location beam", 1, true) or string.find(fullLower, "sparkletube", 1, true) then
			if obj:IsA("Beam") or obj:IsA("Attachment") or obj:IsA("BasePart") then
				local pos = getTargetPosition(obj)
				if pos then
					table.insert(list, pos)
				end
			end
		end
	end
	return list
end

local function findNextUnplacedGoldPos(originPos)
	local allGold = findAllGoldLocations()
	pruneMissingGoldMarkers(allGold)

	local bestPos = nil
	local bestDist = math.huge

	for _, pos in ipairs(allGold) do
		if not isAlreadyPlaced(pos) then
			local d = (pos - originPos).Magnitude
			if d < bestDist then
				bestDist = d
				bestPos = pos
			end
		end
	end

	return bestPos, #allGold > 0
end

-- Mencari khusus PORTAL (bukan ore emas, bukan scan, bukan podium UGC)
local function findPortalTarget(originPos)
	local bestPos, bestPrompt = nil, nil
	local bestDist = math.huge

	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("ProximityPrompt") then
			local act = string.lower(tostring(obj.ActionText or ""))
			local objTxt = string.lower(tostring(obj.ObjectText or ""))
			local fullLow = string.lower(obj:GetFullName())

			local isOreOrScanOrUgc = string.find(fullLow, "ore", 1, true)
				or string.find(act, "ore", 1, true)
				or string.find(objTxt, "ore", 1, true)
				or string.find(fullLow, "scan", 1, true)
				or string.find(act, "scan", 1, true)
				or string.find(objTxt, "scan", 1, true)
				or string.find(fullLow, "sparkletube", 1, true)
				or string.find(fullLow, "location beam", 1, true)
				or string.find(fullLow, "cape", 1, true)
				or string.find(fullLow, "halo", 1, true)
				or string.find(fullLow, "crown", 1, true)
				or string.find(fullLow, "ugc", 1, true)
				or string.find(fullLow, "podium", 1, true)

			local isPortal = not isOreOrScanOrUgc and (
				string.find(fullLow, "portal", 1, true)
				or string.find(act, "portal", 1, true)
				or string.find(objTxt, "portal", 1, true)
				or string.find(objTxt, "lobby", 1, true)
				or string.find(objTxt, "pemburu emas", 1, true)
				or string.find(objTxt, "gold hunters", 1, true)
			)

			if isPortal then
				local pos = getInstanceWorldPos(obj.Parent) or getInstanceWorldPos(obj)
				if pos then
					local d = originPos and (pos - originPos).Magnitude or 0
					if d < bestDist then
						bestDist = d
						bestPos = pos
						bestPrompt = obj
					end
				end
			end
		end
	end

	if bestPos then
		return bestPos, bestPrompt
	end

	return PORTAL_FALLBACK_COORD, nil
end

-- Ketika ore penuh: teleport ke PORTAL dan picu masuk ke PORTAL (bukan ke ore emas)
local function kePortalMapUtamaJikaFull()
	if not autoReturnEnabled then
		returningActive = false
		return false
	end

	if not apakahOrePenuh() then
		returningActive = false
		return false
	end

	returningActive = true

	local char, hrp, hum = getCharParts()
	if not char or not hrp then
		return true
	end

	local portalPos, portalPrompt = findPortalTarget(hrp.Position)

	for _ = 1, 6 do
		if not autoReturnEnabled or not apakahOrePenuh() then
			break
		end
		char, hrp, hum = getCharParts()
		if not hrp then
			break
		end
		if hum then
			hum.PlatformStand = false
		end

		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.CFrame = CFrame.new(portalPos + Vector3.new(0, 1.5, 0))

		if portalPrompt and portalPrompt.Parent then
			triggerPrompt(portalPrompt)
		else
			pressKeyE(0.14)
		end

		task.wait(0.28)
	end

	if not apakahOrePenuh() then
		returningActive = false
	end

	return true
end

local function canTakeTurn(roleName)
	if autoMissionEnabled and smeltEnabled then
		if not sharedTurnOwner then
			sharedTurnOwner = roleName
		end
		return sharedTurnOwner == roleName
	end
	return true
end

local function releaseTurn(roleName)
	if autoMissionEnabled and smeltEnabled and sharedTurnOwner == roleName then
		sharedTurnOwner = (roleName == "mission") and "smelt" or "mission"
	elseif not (autoMissionEnabled and smeltEnabled) then
		sharedTurnOwner = nil
	end
end

-- Loop utama AUTO GOLD: E mengikuti eDelay (makin kecil makin cepat, makin besar makin lambat)
task.spawn(function()
	while true do
		if kePortalMapUtamaJikaFull() then
			task.wait(0.8)
			continue
		end

		if not missionEnabled or shouldPauseGold() then
			task.wait(0.05)
			continue
		end

		local _, hrp = getCharParts()
		if not hrp then
			task.wait(0.2)
			continue
		end

		if not anchorStartPos then
			anchorStartPos = hrp.Position
		end

		local nextGoldPos = findNextUnplacedGoldPos(hrp.Position)
		if nextGoldPos then
			flyToPosition("Kuning Peleburan", nextGoldPos + Vector3.new(0, 2.2, 0))
			if missionEnabled and not shouldPauseGold() then
				local _, curHrp = getCharParts()
				if curHrp then
					curHrp.AssemblyLinearVelocity = Vector3.zero
					curHrp.CFrame = CFrame.new(nextGoldPos + Vector3.new(0, 2.2, 0))
				end
				local actionPrompt = findPromptNearPos(nextGoldPos, 35)
				triggerPromptFast(actionPrompt)
				markGoldPlaced(nextGoldPos)
			end
			task.wait(math.clamp((tonumber(eDelay) or 0.03) * 0.5, 0.01, 0.5))
			continue
		end

		-- Jika kuning-kuning sudah habis/hilang atau semua sudah ditandai, ambil mesin pelebur di tempat SCAN FOR GOLD
		if missionEnabled and not shouldPauseGold() then
			placedGoldMarkers = {}
			local machinePos, machinePrompt = findGoldMachineTakeTarget(hrp.Position)
			if machinePos then
				flyToPosition("Ambil Mesin SCAN FOR GOLD", machinePos + Vector3.new(0, 2.5, 0))
				if missionEnabled and not shouldPauseGold() then
					local nearPrompt = machinePrompt or findPromptNearCoord(machinePos, 28)
					if nearPrompt then
						triggerPrompt(nearPrompt)
					else
						pressKeyE(0.08)
					end
				end

				local waitStart = os.clock()
				while missionEnabled and not shouldPauseGold() and (os.clock() - waitStart) < 2.2 do
					if #findAllGoldLocations() > 0 then
						break
					end
					task.wait(0.12)
				end
			else
				task.wait(0.7)
			end
		end

		task.wait(0.05)
	end
end)

