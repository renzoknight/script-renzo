-- Auto Save & Restore lintas map (Memory + File Executor)
task.spawn(function()
	local SAVE_FILE = "GoldMission_Settings.json"
	local gEnv = (typeof(getgenv) == "function") and getgenv() or nil
	local lEnv = _G
	gEnv = gEnv or lEnv

	gEnv.GoldMissionSaved = gEnv.GoldMissionSaved or lEnv.GoldMissionSaved or {}
	lEnv.GoldMissionSaved = gEnv.GoldMissionSaved

	local function isOnText(btn)
		if not btn then return false end
		return string.find(string.upper(tostring(btn.Text or "")), ": ON", 1, true) ~= nil
	end

	local function writeDiskData(tbl)
		if typeof(writefile) == "function" then
			pcall(function()
				writefile(SAVE_FILE, HttpService:JSONEncode(tbl))
			end)
		end
	end

	local function readDiskData()
		if typeof(isfile) == "function" and typeof(readfile) == "function" then
			local exists = false
			pcall(function()
				exists = isfile(SAVE_FILE)
			end)
			if exists then
				local ok, decoded = pcall(function()
					local raw = readfile(SAVE_FILE)
					return raw and HttpService:JSONDecode(raw) or nil
				end)
				if ok and typeof(decoded) == "table" then
					return decoded
				end
			end
		end
		return nil
	end

	saveAllSettings = function()
		local currentSpeed = tonumber(flySpeed) or 420
		local currentEDelay = tonumber(eDelay) or 0.03
		local data = {
			autoGold = (missionEnabled == true) or isOnText(toggleBtn),
			returnToggle = (autoReturnEnabled == true) or isOnText(returnToggleBtn),
			smelt = (smeltEnabled == true) or isOnText(smeltToggleBtn),
			mission = (autoMissionEnabled == true) or isOnText(missionTeleToggleBtn),
			autoExec = (autoExecEnabled == true) or isOnText(autoExecToggleBtn),
			flySpeed = currentSpeed,
			eDelay = currentEDelay,
		}

		for k, v in pairs(data) do
			gEnv.GoldMissionSaved[k] = v
			lEnv.GoldMissionSaved[k] = v
		end

		writeDiskData(data)
	end

	task.wait(0.25)

	local diskSaved = readDiskData()
	local memSaved = gEnv.GoldMissionSaved or lEnv.GoldMissionSaved or {}
	local saved = {
		autoGold = (diskSaved and diskSaved.autoGold == true) or (memSaved.autoGold == true),
		returnToggle = (diskSaved and diskSaved.returnToggle == true) or (memSaved.returnToggle == true),
		smelt = (diskSaved and diskSaved.smelt == true) or (memSaved.smelt == true),
		mission = (diskSaved and diskSaved.mission == true) or (memSaved.mission == true),
		autoExec = (diskSaved and diskSaved.autoExec == true) or (memSaved.autoExec == true),
		flySpeed = (diskSaved and tonumber(diskSaved.flySpeed)) or (tonumber(memSaved.flySpeed)) or flySpeed,
		eDelay = (diskSaved and tonumber(diskSaved.eDelay)) or (tonumber(memSaved.eDelay)) or eDelay,
	}

	if saved.eDelay and saved.eDelay >= 0.01 and saved.eDelay <= 5 then
		eDelay = saved.eDelay
		eDelayInput.Text = tostring(eDelay)
	end

	if saved.flySpeed and saved.flySpeed >= 40 and saved.flySpeed <= 5000 then
		flySpeed = saved.flySpeed
		flySpeedInput.Text = tostring(flySpeed)
	end

	if saved.autoGold == true then
		missionEnabled = true
		placedGoldMarkers = {}
		local _, hrp = getCharParts()
		anchorStartPos = hrp and hrp.Position or nil
		refreshBtn()
	end

	if saved.returnToggle == true then
		autoReturnEnabled = true
		refreshReturnVisual()
	end

	if saved.smelt == true then
		smeltEnabled = true
		smeltToken += 1
		refreshSmeltVisual()
		local tok = smeltToken
		task.spawn(function()
			runSmeltCycle(tok)
		end)
	end

	if saved.mission == true then
		autoMissionEnabled = true
		missionRunToken += 1
		if refreshMissionVisual then
			refreshMissionVisual()
		end
		if runAutoMissionCycle then
			local currentToken = missionRunToken
			task.spawn(function()
				runAutoMissionCycle(currentToken)
			end)
		end
	end

	if autoMissionEnabled and smeltEnabled and not sharedTurnOwner then
		sharedTurnOwner = "mission"
	end

	if saved.autoExec == true then
		autoExecEnabled = true
		refreshAutoExecVisual()
		syncAutoExecQueue()
	end

	for _, btn in ipairs({toggleBtn, returnToggleBtn, smeltToggleBtn, missionTeleToggleBtn, autoExecToggleBtn}) do
		if typeof(btn) == "Instance" then
			btn:GetPropertyChangedSignal("Text"):Connect(saveAllSettings)
		end
	end

	saveAllSettings()

	while screenGui and screenGui.Parent do
		saveAllSettings()
		task.wait(0.5)
	end
end)
