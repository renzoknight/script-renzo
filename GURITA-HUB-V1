-- 4. RUNNER (Anti-Lag System)
task.spawn(function()
	SetCinematicSky()

	local d = workspace:GetDescendants()
	for i = 1, #d do
		ApplyFlat(d[i])
		if i % 200 == 0 then task.wait() end
	end
end)

workspace.DescendantAdded:Connect(function(v)
	task.delay(2, function()
		ApplyFlat(v)
	end)
end)

-- ==========================================================
-- FUNGSI AUTO JOIN TIM (Menghilangkan Pop-up Papan Peringkat)
-- ==========================================================
local function autoSelectTeam()
	print("[Blox Fruits] Mencoba memilih tim otomatis: " .. config.selectedTeam)
	local re = ReplicatedStorage:FindFirstChild("Remotes") 
		and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
		
	if re then
		pcall(function()
			re:InvokeServer("SetTeam", config.selectedTeam)
		end)
	end
end

-- ==========================================================
-- FUNGSI PENCARIAN BUAH (Diperbaiki: menggunakan findFruit)
-- ==========================================================
local function findFruit()
	for _, obj in ipairs(Workspace:GetChildren()) do
		if obj:IsA("Tool") and (obj.Name:find("Fruit") or obj:FindFirstChild("Handle")) then
			return obj
		end
	end
	return nil
end

-- ==========================================================
-- LOGIKA UTAMA AUTO HOP & PENCARIAN
-- ==========================================================
local function startFruitSearch()
	if not config.autoHopActive then return end

	print("[Blox Fruits] Masuk ke server, merapikan tim...")
	task.wait(2)
	
	autoSelectTeam()
	task.wait(2) 

	local detectedFruit = findFruit() -- Sudah benar menggunakan findFruit
	
	if detectedFruit then
		print("==========================================")
		print("[SUKSES] Buah ditemukan di server ini!")
		print("Nama Buah : " .. detectedFruit.Name)
		print("Status    : DIAM / TIDAK HOP (Menunggu diambil)")
		print("==========================================")
		
		config.autoHopActive = false
		saveConfig()
		
		toggleBtn.Text = "Buah Ketemu! (OFF)"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(241, 196, 15)
		
		if player.Character and player.Character:FindFirstChild("HumanoidRootPart") and detectedFruit:FindFirstChild("Handle") then
			player.Character.HumanoidRootPart.CFrame = detectedFruit.Handle.CFrame + Vector3.new(0, 5, 0)
		end
		
		return 
	end

	print("[Blox Fruits] Buah tidak ada. Melakukan Auto Hop...")
	
	local success, result = pcall(function()
		local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100"
		return HttpService:JSONDecode(game:HttpGet(url))
	end)

	if success and result and result.data then
		local servers = {}
		for _, server in ipairs(result.data) do
			if server.playing < server.maxPlayers and server.id ~= game.JobId then
				table.insert(servers, server.id)
			end
		end

		if #servers > 0 then
			local randomServerId = servers[math.random(1, #servers)]
			TeleportService:TeleportToPlaceInstance(placeId, randomServerId, player, { autoHop = true })
		else
			warn("Server penuh. Mencoba ulang...")
			task.wait(SEARCH_DELAY)
			startFruitSearch()
		end
	else
		warn("Gagal ambil data server. Mencoba ulang...")
		task.wait(SEARCH_DELAY)
		startFruitSearch()
	end
end

-- ==========================================================
-- INTERAKSI TOMBOL GUI
-- ==========================================================
toggleBtn.MouseButton1Click:Connect(function()
	config.autoHopActive = not config.autoHopActive
	saveConfig()
	
	if config.autoHopActive then
		toggleBtn.Text = "Auto Hop: ON"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
		print("[Blox Fruits] Auto Hop diaktifkan.")
		startFruitSearch()
	else
		toggleBtn.Text = "Auto Hop: OFF"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(231, 76, 60)
		print("[Blox Fruits] Auto Hop dimatikan.")
	end
end)

teamBtn.MouseButton1Click:Connect(function()
	if config.selectedTeam == "Pirates" then
		config.selectedTeam = "Marines"
	else
		config.selectedTeam = "Pirates"
	end
	
	teamBtn.Text = "Tim: " .. config.selectedTeam
	saveConfig()
	print("[Blox Fruits] Tim diubah menjadi: " .. config.selectedTeam)
	autoSelectTeam()
end)

if config.autoHopActive then
	task.spawn(function()
		startFruitSearch()
	end)
else
	task.spawn(function()
		task.wait(2)
		autoSelectTeam()
	end)
end
