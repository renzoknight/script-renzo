-- [[ GURITA HUB V4.0 - CINEMATIC SKY & FLAT WORLD ]] --

-- Layanan yang dibutuhkan
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local lp = Players.LocalPlayer
local Lighting = game:GetService("Lighting")

-- 1. PROTEKSI (Agar Executor & Aman tetap aman)
local function isProtected(v)
	if v:IsDescendantOf(lp.Character) then return true end
	if v:IsA("Sky") or v:IsA("Clouds") or v:IsA("Atmosphere") then return true end
	return false
end

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local placeId = game.PlaceId
local SEARCH_DELAY = 5 

-- NAMA FILE UNTUK MENYIMPAN SETTINGAN SECARA PERMANEN DI EXECUTOR
local CONFIG_FILE = "BloxFruits_AutoHop_Config.json"

-- PENGATURAN DEFAULT
local config = {
	autoHopActive = false,
	selectedTeam = "Pirates" -- Pilihan: "Pirates" (Bajak Laut) atau "Marines" (Marinir)
}

-- LOAD CONFIGURASI DARI FILE EXECUTOR (Agar permanen)
if writefile and readfile and isfile then
	if isfile(CONFIG_FILE) then
		local success, decoded = pcall(function()
			return HttpService:JSONDecode(readfile(CONFIG_FILE))
		end)
		if success and type(decoded) == "table" then
			config = decoded
		end
	else
		writefile(CONFIG_FILE, HttpService:JSONEncode(config))
	end
end

-- Fungsi untuk menyimpan ulang config
local function saveConfig()
	if writefile then
		pcall(function()
			writefile(CONFIG_FILE, HttpService:JSONEncode(config))
		end)
	end
end

-- Cek TeleportData agar status tetap terbawa saat hop server
local teleportData = TeleportService:GetLocalPlayerTeleportData()
if teleportData and type(teleportData) == "table" and teleportData.autoHop ~= nil then
	config.autoHopActive = teleportData.autoHop
end

-- 2. FLAT COLOR (Mode Paling Enteng)
local function ApplyFlat(v)
	if (v:IsA("BasePart") or v:IsA("MeshPart")) and not isProtected(v) then
		pcall(function()
			v.Material = Enum.Material.Plastic
			v.CastShadow = false
			if v:IsA("MeshPart") then v.TextureID = "" end
			for _, child in pairs(v:GetChildren()) do
				if child:IsA("Texture") or child:IsA("Decal") then
					child:Destroy()
				end
			end
		end)
	end
end

-- 3. SHADER-STYLE SKY (Bagus tapi GAK BERAT)
local function SetCinematicSky()
	for _, v in pairs(Lighting:GetChildren()) do
		if v:IsA("Sky") or v:IsA("Atmosphere") then v:Destroy() end
	end

	local Sky = Instance.new("Sky", Lighting)
	Sky.SkyboxBk = "rbxassetid://151165214"
	Sky.SkyboxDn = "rbxassetid://151165101"
	Sky.SkyboxFt = "rbxassetid://151165224"
	Sky.SkyboxLf = "rbxassetid://151165231"
	Sky.SkyboxRt = "rbxassetid://151165274"
	Sky.SkyboxUp = "rbxassetid://151165281"
	Sky.SunAngularSize = 15

	local terrain = workspace:FindFirstChildOfClass("Terrain")
	if terrain then
		local clouds = terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds", terrain)
		clouds.Enabled = true
		clouds.Cover = 0.6 
		clouds.Density = 0.4 
		clouds.Color = Color3.new(1, 1, 1)
	end

	local atmo = Instance.new("Atmosphere", Lighting)
	atmo.Density = 0.25
	atmo.Offset = 0.1
	atmo.Color = Color3.fromRGB(190, 190, 190)
	atmo.Decay = Color3.fromRGB(100, 100, 100)
	atmo.Glare = 0.1
	atmo.Haze = 0.5 

	Lighting.ClockTime = 14
	Lighting.Brightness = 2.5
	Lighting.ExposureCompensation = 0.2
end

