-- Auto Executor (Queue On Teleport via GitHub Raw)
local function queueScriptOnTeleport()
	if not GITHUB_RAW_URL or GITHUB_RAW_URL == "" or string.find(GITHUB_RAW_URL, "USERNAME/REPO", 1, true) then
		return false
	end

	local payload = string.format(
		"if not game:IsLoaded() then game.Loaded:Wait() end; pcall(function() loadstring(game:HttpGet(%q))() end)",
		GITHUB_RAW_URL
	)

	local queueFn = nil
	if type(queue_on_teleport) == "function" then
		queueFn = queue_on_teleport
	elseif type(queueonteleport) == "function" then
		queueFn = queueonteleport
	elseif type(syn) == "table" and type(syn.queue_on_teleport) == "function" then
		queueFn = syn.queue_on_teleport
	end

	if queueFn then
		local ok = pcall(queueFn, payload)
		return ok == true
	end
	return false
end

if localPlayer then
	localPlayer.OnTeleport:Connect(function()
		saveSettings()
		queueScriptOnTeleport()
	end)
end

-- Fly State (ringan, tidak recreate BodyMover tiap frame)
local flyEnabled = false
local flySpeed = cfg.flySpeed
local flyConn = nil
local flyVel = nil
local flyGyro = nil

local function cleanupFlyInstances()
	if flyVel then
		pcall(function()
			flyVel:Destroy()
		end)
		flyVel = nil
	end
	if flyGyro then
		pcall(function()
			flyGyro:Destroy()
		end)
		flyGyro = nil
	end
end

local function stopFly()
	flyEnabled = false
	if flyConn then
		flyConn:Disconnect()
		flyConn = nil
	end
	cleanupFlyInstances()

	local char = localPlayer and localPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		pcall(function()
			hum.PlatformStand = false
		end)
	end
end

local function ensureFlyMover(char)
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then
		return nil, nil
	end

	if not hum.PlatformStand then
		hum.PlatformStand = true
	end

	if not flyVel or flyVel.Parent ~= hrp then
		cleanupFlyInstances()
		local bv = Instance.new("BodyVelocity")
		bv.Name = "GeminiFlyVel"
		bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
		bv.Velocity = Vector3.zero
		bv.Parent = hrp
		flyVel = bv

		local bg = Instance.new("BodyGyro")
		bg.Name = "GeminiFlyGyro"
		bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
		bg.P = 1e4
		bg.CFrame = hrp.CFrame
		bg.Parent = hrp
		flyGyro = bg
	end

	return hrp, hum
end

local function startFly()
	stopFly()
	flyEnabled = true

	if localPlayer and localPlayer.Character then
		ensureFlyMover(localPlayer.Character)
	end

	flyConn = RunService.Heartbeat:Connect(function()
		if not flyEnabled then
			return
		end
		local char = localPlayer and localPlayer.Character
		local hrp = ensureFlyMover(char)
		local cam = workspace.CurrentCamera
		if not hrp or not cam then
			return
		end

		local moveDir = Vector3.zero
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then
			moveDir += cam.CFrame.LookVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then
			moveDir -= cam.CFrame.LookVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then
			moveDir += cam.CFrame.RightVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then
			moveDir -= cam.CFrame.RightVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) or UserInputService:IsKeyDown(Enum.KeyCode.E) then
			moveDir += Vector3.yAxis
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.Q) then
			moveDir -= Vector3.yAxis
		end

		if moveDir.Magnitude > 0 then
			moveDir = moveDir.Unit * flySpeed
		end

		if flyVel then
			flyVel.Velocity = moveDir
		end
		if flyGyro then
			flyGyro.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + cam.CFrame.LookVector)
		end
	end)
end

-- Helper Cari Posisi & Teleport ke Booth / Pet
local function getTargetCFrame(inst)
	if not inst or not inst.Parent then
		return nil
	end
	if inst:IsA("BasePart") then
		return inst.CFrame
	end
	if inst:IsA("Model") then
		if inst.PrimaryPart then
			return inst.PrimaryPart.CFrame
		end
		local ok, cf = pcall(function()
			return inst:GetPivot()
		end)
		if ok and cf then
			return cf
		end
	end

	local cur = inst.Parent
	local depth = 0
	while cur and cur ~= workspace and depth < 12 do
		if cur:IsA("BasePart") then
			return cur.CFrame
		elseif cur:IsA("Model") then
			if cur.PrimaryPart then
				return cur.PrimaryPart.CFrame
			end
			local ok, cf = pcall(function()
				return cur:GetPivot()
			end)
			if ok and cf then
				return cf
			end
		end
		cur = cur.Parent
		depth += 1
	end

	return nil
end

local function findBoothByPlayerName(text)
	if type(text) ~= "string" then
		return nil
	end
	local lower = string.lower(text)
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= localPlayer then
			local n1 = string.lower(plr.Name)
			local n2 = string.lower(plr.DisplayName)
			if string.find(lower, n1, 1, true) or string.find(lower, n2, 1, true) then
				for _, obj in ipairs(workspace:GetChildren()) do
					local objLower = string.lower(obj.Name)
					if string.find(objLower, "booth", 1, true) or string.find(objLower, "stall", 1, true) or string.find(objLower, "stand", 1, true) then
						local ownerAttr = obj:GetAttribute("Owner") or obj:GetAttribute("UserId")
						if tostring(ownerAttr) == tostring(plr.UserId) or string.find(string.lower(tostring(ownerAttr)), n1, 1, true) then
							local cf = getTargetCFrame(obj)
							if cf then
								return cf
							end
						end
					end
				end

				local pChar = plr.Character
				local pHrp = pChar and pChar:FindFirstChild("HumanoidRootPart")
				if pHrp then
					return pHrp.CFrame
				end
			end
		end
	end
	return nil
end

local function teleportToEntry(entry)
	if not entry then
		return
	end
	local char = localPlayer and localPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end

	local targetCf = nil
	if entry.instance and entry.instance:IsDescendantOf(workspace) then
		targetCf = getTargetCFrame(entry.instance)
	end

	if not targetCf and entry.contextText then
		targetCf = findBoothByPlayerName(entry.contextText)
	end

	if not targetCf and entry.uiButton and typeof(firesignal) == "function" then
		pcall(function()
			firesignal(entry.uiButton.MouseButton1Click)
		end)
		return
	end

	if targetCf then
		hrp.CFrame = targetCf + Vector3.new(0, 4, 0)
	end
end

-- Pet Scanner (KG + Token, Chunked & Terbatas)
local MAX_RESULTS = 50
local isScanning = false

local function extractKg(text)
	if type(text) ~= "string" then
		return nil
	end
	local numStr = text:match("(%d+%.?%d*)%s*[kK][gG]")
	if numStr then
		return tonumber(numStr)
	end
	return nil
end

local function extractToken(text)
	if type(text) ~= "string" then
		return nil
	end
	local tokStr = text:match("(%d+%.?%d*)%s*[tT][oO][kK][eE][nN]")
		or text:match("[tT][oO][kK][eE][nN]%s*:?%s*(%d+%.?%d*)")
		or text:match("(%d+%.?%d*)%s*[tT]$")
	if tokStr then
		return tonumber(tokStr)
	end
	return nil
end

local function scanPetsByNameAsync(query)
	local cleanQuery = string.lower((query or ""):gsub("^%s+", ""):gsub("%s+$", ""))
	local results = {}
	if cleanQuery == "" then
		return results
	end

	local seen = {}
	local pg = localPlayer and localPlayer:FindFirstChildOfClass("PlayerGui")
	local targets = {}

	if pg then
		for _, d in ipairs(pg:GetDescendants()) do
			if d:IsA("TextLabel") or d:IsA("TextButton") then
				table.insert(targets, d)
			end
		end
	end

	for _, child in ipairs(workspace:GetChildren()) do
		if child:IsA("Model") or child:IsA("Folder") then
			table.insert(targets, child)
			for _, sub in ipairs(child:GetChildren()) do
				if sub:IsA("Model") or sub:IsA("Folder") or sub:IsA("BasePart") then
					table.insert(targets, sub)
				end
			end
		end
	end

	local processed = 0
	for _, desc in ipairs(targets) do
		if #results >= MAX_RESULTS then
			break
		end

		processed += 1
		if processed % 250 == 0 then
			task.wait()
		end

		local candidateName = nil
		local candidateKg = nil
		local candidateToken = nil
		local contextParts = {}
		local linkedBtn = nil

		if desc:IsA("TextLabel") or desc:IsA("TextButton") then
			local txt = desc.Text or ""
			if #txt > 0 and #txt < 160 and string.find(string.lower(txt), cleanQuery, 1, true) then
				candidateName = txt
				candidateKg = extractKg(txt)
				candidateToken = extractToken(txt)
				table.insert(contextParts, txt)

				if desc.Parent then
					for _, sib in ipairs(desc.Parent:GetChildren()) do
						if sib:IsA("TextLabel") or sib:IsA("TextButton") then
							local sTxt = sib.Text or ""
							table.insert(contextParts, sTxt)
							if not candidateKg then
								candidateKg = extractKg(sTxt)
							end
							if not candidateToken then
								candidateToken = extractToken(sTxt)
							end
							if sib:IsA("TextButton") and not linkedBtn then
								linkedBtn = sib
							end
						end
					end
				end
			end
		else
			if string.find(string.lower(desc.Name), cleanQuery, 1, true) then
				candidateName = desc.Name
				table.insert(contextParts, desc.Name)

				local attrKg = desc:GetAttribute("KG") or desc:GetAttribute("Kg") or desc:GetAttribute("Weight")
				if type(attrKg) == "number" then
					candidateKg = attrKg
				elseif type(attrKg) == "string" then
					candidateKg = tonumber(attrKg) or extractKg(attrKg)
				end

				local attrTok = desc:GetAttribute("Token") or desc:GetAttribute("Tokens") or desc:GetAttribute("Price")
				if type(attrTok) == "number" then
					candidateToken = attrTok
				elseif type(attrTok) == "string" then
					candidateToken = tonumber(attrTok) or extractToken(attrTok)
				end
			end
		end

		if candidateName then
			local kgVal = candidateKg or 0
			local sig = tostring(candidateName) .. "|" .. tostring(kgVal) .. "|" .. tostring(candidateToken or "")
			if not seen[sig] then
				seen[sig] = true
				table.insert(results, {
					name = tostring(candidateName),
					kg = kgVal,
					hasKg = candidateKg ~= nil,
					token = candidateToken,
					instance = desc,
					contextText = table.concat(contextParts, " "),
					uiButton = linkedBtn,
				})
			end
		end
	end

	table.sort(results, function(a, b)
		if a.kg ~= b.kg then
			return a.kg > b.kg
		end
		return a.name < b.name
	end)

	return results
end

