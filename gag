-- Fly State (ringan)
local flyEnabled = false
local flySpeed = cfg.flySpeed
local flyConn = nil
local flyVel = nil
local flyGyro = nil

local function cleanupFlyInstances()
	if flyVel then
		pcall(function()
			flyVel:Destroy()
		end)
		flyVel = nil
	end
	if flyGyro then
		pcall(function()
			flyGyro:Destroy()
		end)
		flyGyro = nil
	end
end

local function stopFly()
	flyEnabled = false
	if flyConn then
		flyConn:Disconnect()
		flyConn = nil
	end
	cleanupFlyInstances()

	local char = localPlayer and localPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		pcall(function()
			hum.PlatformStand = false
		end)
	end
end

local function ensureFlyMover(char)
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then
		return nil, nil
	end

	if not hum.PlatformStand then
		hum.PlatformStand = true
	end

	if not flyVel or flyVel.Parent ~= hrp then
		cleanupFlyInstances()
		local bv = Instance.new("BodyVelocity")
		bv.Name = "GeminiFlyVel"
		bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
		bv.Velocity = Vector3.zero
		bv.Parent = hrp
		flyVel = bv

		local bg = Instance.new("BodyGyro")
		bg.Name = "GeminiFlyGyro"
		bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
		bg.P = 1e4
		bg.CFrame = hrp.CFrame
		bg.Parent = hrp
		flyGyro = bg
	end

	return hrp, hum
end

local function startFly()
	stopFly()
	flyEnabled = true

	if localPlayer and localPlayer.Character then
		ensureFlyMover(localPlayer.Character)
	end

	flyConn = RunService.Heartbeat:Connect(function()
		if not flyEnabled then
			return
		end
		local char = localPlayer and localPlayer.Character
		local hrp = ensureFlyMover(char)
		local cam = workspace.CurrentCamera
		if not hrp or not cam then
			return
		end

		local moveDir = Vector3.zero
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then
			moveDir += cam.CFrame.LookVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then
			moveDir -= cam.CFrame.LookVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then
			moveDir += cam.CFrame.RightVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then
			moveDir -= cam.CFrame.RightVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) or UserInputService:IsKeyDown(Enum.KeyCode.E) then
			moveDir += Vector3.yAxis
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.Q) then
			moveDir -= Vector3.yAxis
		end

		if moveDir.Magnitude > 0 then
			moveDir = moveDir.Unit * flySpeed
		end

		if flyVel then
			flyVel.Velocity = moveDir
		end
		if flyGyro then
			flyGyro.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + cam.CFrame.LookVector)
		end
	end)
end

-- Helper Cari Posisi & Teleport ke Booth / Pet
local function getTargetCFrame(inst)
	if not inst or not inst.Parent then
		return nil
	end
	if inst:IsA("BasePart") then
		return inst.CFrame
	end
	if inst:IsA("Model") then
		if inst.PrimaryPart then
			return inst.PrimaryPart.CFrame
		end
		local ok, cf = pcall(function()
			return inst:GetPivot()
		end)
		if ok and cf then
			return cf
		end
	end

	local cur = inst.Parent
	local depth = 0
	while cur and cur ~= workspace and depth < 14 do
		if cur:IsA("BasePart") then
			return cur.CFrame
		elseif cur:IsA("Model") then
			if cur.PrimaryPart then
				return cur.PrimaryPart.CFrame
			end
			local ok, cf = pcall(function()
				return cur:GetPivot()
			end)
			if ok and cf then
				return cf
			end
		end
		cur = cur.Parent
		depth += 1
	end

	return nil
end

local function isBoothLike(obj)
	local n = string.lower(obj.Name or "")
	return string.find(n, "booth", 1, true)
		or string.find(n, "stall", 1, true)
		or string.find(n, "stand", 1, true)
		or string.find(n, "shop", 1, true)
		or string.find(n, "plaza", 1, true)
		or string.find(n, "trade", 1, true)
end

local function findBoothByPlayerName(text)
	if type(text) ~= "string" then
		return nil
	end
	local lower = string.lower(text)
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= localPlayer then
			local n1 = string.lower(plr.Name)
			local n2 = string.lower(plr.DisplayName)
			if (#n1 > 0 and string.find(lower, n1, 1, true)) or (#n2 > 0 and string.find(lower, n2, 1, true)) then
				for _, obj in ipairs(workspace:GetDescendants()) do
					if isBoothLike(obj) and (obj:IsA("Model") or obj:IsA("BasePart") or obj:IsA("Folder")) then
						local ownerAttr = obj:GetAttribute("Owner") or obj:GetAttribute("UserId") or obj:GetAttribute("Player") or obj:GetAttribute("Seller")
						if tostring(ownerAttr) == tostring(plr.UserId)
							or (#n1 > 0 and string.find(string.lower(tostring(ownerAttr or "")), n1, 1, true))
							or (#n2 > 0 and string.find(string.lower(tostring(ownerAttr or "")), n2, 1, true)) then
							local cf = getTargetCFrame(obj)
							if cf then
								return cf
							end
						end
					end
				end

				local pChar = plr.Character
				local pHrp = pChar and pChar:FindFirstChild("HumanoidRootPart")
				if pHrp then
					return pHrp.CFrame
				end
			end
		end
	end
	return nil
end

local function findNearestBoothFallback(hrp)
	if not hrp then
		return nil
	end
	local bestCf = nil
	local bestDist = math.huge
	for _, obj in ipairs(workspace:GetDescendants()) do
		if isBoothLike(obj) and (obj:IsA("Model") or obj:IsA("BasePart")) then
			local cf = getTargetCFrame(obj)
			if cf then
				local dist = (cf.Position - hrp.Position).Magnitude
				if dist < bestDist then
					bestDist = dist
					bestCf = cf
				end
			end
		end
	end
	return bestCf
end

local function moveCharacterToCFrame(hrp, targetCf)
	if not hrp or not targetCf then
		return
	end
	local dest = targetCf + Vector3.new(0, 4.5, 0)
	local wasFly = flyEnabled
	if wasFly then
		stopFly()
	end
	pcall(function()
		local char = hrp.Parent
		if char and char:IsA("Model") and char.PrimaryPart then
			char:PivotTo(CFrame.new(dest.Position, dest.Position + targetCf.LookVector))
		else
			hrp.CFrame = CFrame.new(dest.Position, dest.Position + targetCf.LookVector)
		end
	end)
	if wasFly then
		task.delay(0.15, function()
			if memorySettings.flyEnabled then
				startFly()
			end
		end)
	end
end

local function teleportToEntry(entry)
	if not entry then
		return
	end
	local char = localPlayer and localPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end

	-- 1. Coba langsung dari instance di workspace
	if entry.instance and entry.instance:IsDescendantOf(workspace) then
		local cf = getTargetCFrame(entry.instance)
		if cf then
			moveCharacterToCFrame(hrp, cf)
			return
		end
	end

	-- 2. Cari booth/pemain dari teks konteks
	if entry.contextText then
		local cf = findBoothByPlayerName(entry.contextText)
		if cf then
			moveCharacterToCFrame(hrp, cf)
			return
		end
	end

	-- 3. Klik tombol aksi/TP di dalam container UI yang sama jika ada
	if entry.uiButton and typeof(firesignal) == "function" then
		local fired = pcall(function()
			firesignal(entry.uiButton.MouseButton1Click)
		end)
		if fired then
			return
		end
	end

	-- 4. Fallback ke booth terdekat jika UI tidak menyertakan koordinat/nama seller
	local nearBooth = findNearestBoothFallback(hrp)
	if nearBooth then
		moveCharacterToCFrame(hrp, nearBooth)
	end
end

-- Pet Scanner (KG + Token fleksibel, Chunked & Terbatas)
local MAX_RESULTS = 50
local isScanning = false

local function parseNumberSuffix(numStr, suffix)
	local val = tonumber(numStr)
	if not val then
		return nil
	end
	local s = string.lower(suffix or "")
	if s == "k" then
		val = val * 1e3
	elseif s == "m" then
		val = val * 1e6
	elseif s == "b" then
		val = val * 1e9
	end
	return val
end

local function extractKg(text)
	if type(text) ~= "string" then
		return nil
	end
	local numStr = text:match("(%d+%.?%d*)%s*[kK][gG]")
	if numStr then
		return tonumber(numStr)
	end
	return nil
end

local function extractToken(text)
	if type(text) ~= "string" then
		return nil
	end
	-- Abaikan teks yang jelas-jelas berat KG
	local cleaned = text:gsub("(%d+%.?%d*)%s*[kK][gG]", "")

	-- Pola eksplisit kata token / t
	local n1, s1 = cleaned:match("(%d+%.?%d*)%s*([kKmMbB]?)%s*[tT][oO][kK][eE][nN][sS]?")
	if n1 then
		return parseNumberSuffix(n1, s1)
	end

	local s2, n2 = cleaned:match("[tT][oO][kK][eE][nN][sS]?%s*:?%s*([kKmMbB]?)%s*(%d+%.?%d*)")
	if n2 then
		return parseNumberSuffix(n2, s2)
	end

	-- Pola angka dengan suffix K/M/B atau berdiri sendiri di label harga (bukan KG)
	local n3, s3 = cleaned:match("(%d+%.?%d*)%s*([kKmMbB])%f[^%a]")
	if n3 then
		return parseNumberSuffix(n3, s3)
	end

	local n4 = cleaned:match("^%s*(%d[%d,%.]*)%s*$")
	if n4 then
		local plain = n4:gsub(",", "")
		local num = tonumber(plain)
		if num and num > 0 then
			return num
		end
	end

	return nil
end

local function formatTokenDisplay(tok)
	if type(tok) ~= "number" then
		return "- Token"
	end
	if tok >= 1e6 then
		return string.format("%.2fM Token", tok / 1e6)
	elseif tok >= 1e3 then
		return string.format("%.1fK Token", tok / 1e3)
	end
	return tostring(tok) .. " Token"
end

local function collectSearchRootsAndNodes()
	local nodes = {}
	local pg = localPlayer and localPlayer:FindFirstChildOfClass("PlayerGui")
	if pg then
		for _, d in ipairs(pg:GetDescendants()) do
			if d:IsA("TextLabel") or d:IsA("TextButton") then
				table.insert(nodes, d)
			end
		end
	end

	for _, child in ipairs(workspace:GetChildren()) do
		if child:IsA("Model") or child:IsA("Folder") then
			table.insert(nodes, child)
			for _, sub in ipairs(child:GetChildren()) do
				if sub:IsA("Model") or sub:IsA("Folder") or sub:IsA("BasePart") then
					table.insert(nodes, sub)
				end
			end
		end
	end

	return nodes
end

local function scanPetsByNameAsync(query)
	local cleanQuery = string.lower((query or ""):gsub("^%s+", ""):gsub("%s+$", ""))
	local results = {}
	if cleanQuery == "" then
		return results
	end

	local seen = {}
	local targets = collectSearchRootsAndNodes()
	local processed = 0

	for _, desc in ipairs(targets) do
		if #results >= MAX_RESULTS then
			break
		end

		processed += 1
		if processed % 250 == 0 then
			task.wait()
		end

		local candidateName = nil
		local candidateKg = nil
		local candidateToken = nil
		local contextParts = {}
		local linkedBtn = nil

		if desc:IsA("TextLabel") or desc:IsA("TextButton") then
			local txt = desc.Text or ""
			if #txt > 0 and #txt < 180 and string.find(string.lower(txt), cleanQuery, 1, true) then
				candidateName = txt
				candidateKg = extractKg(txt)
				candidateToken = extractToken(txt)
				table.insert(contextParts, txt)

				-- Cek beberapa tingkat parent agar ketemu label KG / Token / tombol TP di kartu booth
				local container = desc.Parent
				local hop = 0
				while container and container ~= localPlayer and hop < 4 do
					for _, sib in ipairs(container:GetDescendants()) do
						if sib:IsA("TextLabel") or sib:IsA("TextButton") then
							local sTxt = sib.Text or ""
							if #sTxt > 0 and #sTxt < 140 then
								table.insert(contextParts, sTxt)
								if not candidateKg then
									candidateKg = extractKg(sTxt)
								end
								if not candidateToken then
									candidateToken = extractToken(sTxt)
								end
								if sib:IsA("TextButton") and not linkedBtn then
									local bLow = string.lower(sTxt)
									if string.find(bLow, "tp", 1, true) or string.find(bLow, "go", 1, true) or string.find(bLow, "visit", 1, true) or string.find(bLow, "buy", 1, true) then
										linkedBtn = sib
									end
								end
							end
						end
					end
					container = container.Parent
					hop += 1
				end
			end
		else
			if string.find(string.lower(desc.Name), cleanQuery, 1, true) then
				candidateName = desc.Name
				table.insert(contextParts, desc.Name)

				local attrKg = desc:GetAttribute("KG") or desc:GetAttribute("Kg") or desc:GetAttribute("Weight")
				if type(attrKg) == "number" then
					candidateKg = attrKg
				elseif type(attrKg) == "string" then
					candidateKg = tonumber(attrKg) or extractKg(attrKg)
				end

				local attrTok = desc:GetAttribute("Token") or desc:GetAttribute("Tokens") or desc:GetAttribute("Price") or desc:GetAttribute("Cost")
				if type(attrTok) == "number" then
					candidateToken = attrTok
				elseif type(attrTok) == "string" then
					candidateToken = tonumber(attrTok) or extractToken(attrTok)
				end

				for _, sub in ipairs(desc:GetDescendants()) do
					if sub:IsA("TextLabel") or sub:IsA("TextButton") then
						local sTxt = sub.Text or ""
						if #sTxt > 0 and #sTxt < 140 then
							table.insert(contextParts, sTxt)
							if not candidateKg then
								candidateKg = extractKg(sTxt)
							end
							if not candidateToken then
								candidateToken = extractToken(sTxt)
							end
						end
					end
				end
			end
		end

		if candidateName then
			local kgVal = candidateKg or 0
			local sig = tostring(candidateName) .. "|" .. tostring(kgVal) .. "|" .. tostring(candidateToken or "")
			if not seen[sig] then
				seen[sig] = true
				table.insert(results, {
					name = tostring(candidateName),
					kg = kgVal,
					hasKg = candidateKg ~= nil,
					token = candidateToken,
					instance = desc,
					contextText = table.concat(contextParts, " "),
					uiButton = linkedBtn,
				})
			end
		end
	end

	table.sort(results, function(a, b)
		if a.kg ~= b.kg then
			return a.kg > b.kg
		end
		return a.name < b.name
	end)

	return results
end

