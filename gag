-- Save & Load Settings
local memorySettings = {
	flyEnabled = false,
	flySpeed = 50,
	lastPetQuery = "",
}

local function canUseFileIo()
	return type(writefile) == "function" and type(readfile) == "function"
end

local function loadSettings()
	if canUseFileIo() then
		local exists = true
		if type(isfile) == "function" then
			local ok, res = pcall(isfile, SETTINGS_FILE)
			exists = ok and res == true
		end
		if exists then
			local ok, raw = pcall(readfile, SETTINGS_FILE)
			if ok and type(raw) == "string" and #raw > 0 then
				local decOk, decoded = pcall(function()
					return HttpService:JSONDecode(raw)
				end)
				if decOk and type(decoded) == "table" then
					if type(decoded.flyEnabled) == "boolean" then
						memorySettings.flyEnabled = decoded.flyEnabled
					end
					if type(decoded.flySpeed) == "number" then
						memorySettings.flySpeed = math.clamp(decoded.flySpeed, 5, 300)
					end
					if type(decoded.lastPetQuery) == "string" then
						memorySettings.lastPetQuery = decoded.lastPetQuery
					end
				end
			end
		end
	end
	return memorySettings
end

local function saveSettings()
	if canUseFileIo() then
		local encOk, encoded = pcall(function()
			return HttpService:JSONEncode(memorySettings)
		end)
		if encOk and type(encoded) == "string" then
			pcall(writefile, SETTINGS_FILE, encoded)
		end
	end
end

