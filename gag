local function formatKgToken(item)
	local kgText = item.hasKg and (tostring(item.kg) .. " kg") or "? kg"
	local tokText = item.token and (tostring(item.token) .. " Token") or "- Token"
	return kgText .. " | " .. tokText
end

local function renderResults(list)
	for _, child in ipairs(petScroll:GetChildren()) do
		child:Destroy()
	end

	local count = #list
	listHeader.Text = count >= MAX_RESULTS and string.format("pet (%d+)", count) or string.format("pet (%d)", count)

	if count == 0 then
		bestEntry = nil
		topTpBtn.Visible = false
		topKgLbl.Text = "pet kg yang paling besar: -"
		petScroll.CanvasSize = UDim2.fromOffset(0, 0)
		return
	end

	bestEntry = list[1]
	topTpBtn.Visible = true
	topKgLbl.Text = string.format(
		"terbesar: %s (%s)",
		bestEntry.name,
		formatKgToken(bestEntry)
	)

	local rowH = 32
	local gap = 4
	for i, item in ipairs(list) do
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, -8, 0, rowH)
		row.Position = UDim2.fromOffset(2, (i - 1) * (rowH + gap))
		row.BackgroundColor3 = Color3.fromRGB(12, 19, 34)
		row.BorderSizePixel = 0
		row.Parent = petScroll
		Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

		local lbl = Instance.new("TextLabel")
		lbl.Size = UDim2.new(1, -64, 1, 0)
		lbl.Position = UDim2.fromOffset(8, 0)
		lbl.BackgroundTransparency = 1
		lbl.Text = string.format("%d. %s — %s", i, item.name, formatKgToken(item))
		lbl.TextColor3 = Color3.fromRGB(238, 245, 255)
		lbl.TextXAlignment = Enum.TextXAlignment.Left
		lbl.TextTruncate = Enum.TextTruncate.AtEnd
		lbl.Font = Enum.Font.GothamSemibold
		lbl.TextSize = 12
		lbl.Parent = row

		local tpBtn = Instance.new("TextButton")
		tpBtn.Size = UDim2.fromOffset(46, 22)
		tpBtn.Position = UDim2.new(1, -52, 0.5, -11)
		tpBtn.BackgroundColor3 = Color3.fromRGB(36, 138, 92)
		tpBtn.Text = "TP"
		tpBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		tpBtn.Font = Enum.Font.GothamBold
		tpBtn.TextSize = 11
		tpBtn.BorderSizePixel = 0
		tpBtn.Parent = row
		Instance.new("UICorner", tpBtn).CornerRadius = UDim.new(0, 5)

		tpBtn.MouseButton1Click:Connect(function()
			teleportToEntry(item)
		end)
	end

	petScroll.CanvasSize = UDim2.fromOffset(0, count * (rowH + gap))
end

local function doSearch()
	if isScanning then
		return
	end
	memorySettings.lastPetQuery = petBox.Text or ""
	saveSettings()

	isScanning = true
	searchBtn.Text = "..."
	task.spawn(function()
		local ok, found = pcall(scanPetsByNameAsync, petBox.Text)
		if ok and found then
			renderResults(found)
		end
		isScanning = false
		if searchBtn and searchBtn.Parent then
			searchBtn.Text = "cari"
		end
	end)
end

searchBtn.MouseButton1Click:Connect(doSearch)
petBox.FocusLost:Connect(function(enterPressed)
	memorySettings.lastPetQuery = petBox.Text or ""
	saveSettings()
	if enterPressed then
		doSearch()
	end
end)

closeBtn.MouseButton1Click:Connect(function()
	saveSettings()
	stopFly()
	screenGui:Destroy()
end)

